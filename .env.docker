# 自託管 Supabase 環境變數
# 複製此檔案為 .env.local 並修改相應的設定

############
# 服務設定
############

# Studio 設定
STUDIO_DEFAULT_ORGANIZATION="Office Map"
STUDIO_DEFAULT_PROJECT="Office Map System"
STUDIO_PORT=3000

# API 設定
SUPABASE_PUBLIC_URL=http://192.168.52.112:8000
API_EXTERNAL_URL=http://192.168.52.112:8000
SITE_URL=http://192.168.52.112:3000

# 重定向 URLs (以逗號分隔)
ADDITIONAL_REDIRECT_URLS="http://192.168.52.112:3000/**"

############
# 映像版本與鏡像設定（可自訂）
############
# 可選：使用鏡像倉庫前綴（例如中國大陸環境）
# 例如：REGISTRY_PREFIX=docker.m.daocloud.io/
REGISTRY_PREFIX=

# 各服務映像標籤（必要時可調整）
# v2.0: 使用經過驗證的相容版本，支援 *_IMAGE 變數覆寫映像來源
STUDIO_TAG=20241010
KONG_TAG=3.7
GOTRUE_TAG=v2.158.1
POSTGREST_TAG=v12.2.3
REALTIME_TAG=v2.30.23
STORAGE_TAG=v1.5.3
IMGPROXY_TAG=v3.8.0
POSTGRES_META_TAG=v0.84.2
EDGE_RUNTIME_TAG=v1.58.2
LOGFLARE_TAG=1.4.0
POSTGRES_TAG=15.1.1.78
VECTOR_TAG=0.28.1-alpine

# 高級映像配置（可選）
# 覆寫特定服務的映像來源，例如：
# GOTRUE_IMAGE=ghcr.io/supabase/gotrue
# STUDIO_IMAGE=ghcr.io/supabase/studio


############
# 資料庫設定
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=your_super_secret_password

# PostgREST 設定
PGRST_DB_SCHEMAS=public,storage,graphql_public

############
# Auth 設定
############

# JWT 設定 - 請生成新的密鑰
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# 註冊設定
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

# SMTP 設定 (可選)
SMTP_ADMIN_EMAIL=admin@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_SENDER_NAME="Office Map System"

# Auth 郵件範本路徑
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

############
# API Keys (生成新的密鑰)
############

# 匿名金鑰 (公開)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# 服務角色金鑰 (私密)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

############
# 分析設定
############

LOGFLARE_API_KEY=your-super-secret-logflare-key

############
# Kong 設定
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# 儲存設定
############

# 啟用 WebP 檢測
IMGPROXY_ENABLE_WEBP_DETECTION=false

############
# Edge Functions 設定
############

FUNCTIONS_VERIFY_JWT=false

############
# Docker 設定
############

# Docker socket 位置
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# 離線/跳過拉取模式
OFFLINE_MODE=false
SKIP_PULL=false